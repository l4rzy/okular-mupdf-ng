# Maintainer: rzy <me@23ro.org>
pkgbase=okular-mupdf-ng-git
pkgname=okular-mupdf-ng-git
_pkgname=okular-mupdf-ng
# Keep the MuPDF version and checksum in sync with cmake/mupdf.version.
_mupdfver=1.28.5
pkgver=0.5.5
pkgrel=1
pkgdesc="A MuPDF-based secure and fast backend for Okular. Supports PDF, ePUB, MOBI, AZW3, and KFX"
arch=('x86_64')
url="https://github.com/l4rzy/okular-mupdf-ng"
license=('AGPL-3.0-or-later AND GPL-3.0-or-later AND OFL-1.1')
# Direct ELF dependencies of the installed CLI, worker, and generator (lddtree).
depends=('brotli' 'freetype2' 'glibc' 'kconfig' 'kconfigwidgets'
         'kcoreaddons' 'ki18n' 'kio' 'kwidgetsaddons' 'kxmlgui' 'libjpeg-turbo'
         'libgcc' 'libseccomp' 'libstdc++' 'nspr' 'nss' 'okular' 'qt6-base' 'zlib')
# Keep cargo unversioned so rustup can provide it; Cargo enforces rust-version.
makedepends=('cmake>=3.20' 'extra-cmake-modules>=6.3.0' 'gcc' 'gettext' 'git'
             'make' 'ninja' 'patch' 'pkgconf' 'python' 'qt6-tools' 'cargo')
checkdepends=('openssl' 'tesseract-data-eng' 'ttf-dejavu')
provides=('okular-mupdf-ng')
conflicts=('okular-mupdf-ng')
source=("$_pkgname::git+$url.git"
        "https://github.com/ArtifexSoftware/mupdf-downloads/releases/download/$_mupdfver/mupdf-$_mupdfver-source.tar.gz")
sha256sums=('SKIP'
            '98a5c10cda20c3992cdf76ff6b2a1149c32bd79cc796d3f703230b1185b7e934')

pkgver() {
  cd "$srcdir/$_pkgname"
  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null | sed -e 's/^v//' -e 's/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cmake -B "$srcdir/build" -S "$srcdir/$_pkgname" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKDE_INSTALL_LIBDIR=lib \
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
    -DUSE_SYSTEM_MUPDF=OFF \
    -DMUPDF_SOURCE_DIR="$srcdir/mupdf-$_mupdfver-source" \
    -DBUILD_TESTING=ON \
    -DENABLE_BUILD_TREE_WORKER=OFF \
    -DENABLE_MU_DEBUG=OFF \
    -DDISABLE_WORKER_SANDBOX=OFF \
    -DTESSDATA_DIR=/usr/share/tessdata
  cmake --build "$srcdir/build"
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  # The signature appearance depends on the bundled font; fail the package
  # rather than silently shipping a build whose install rule dropped it.
  test -f "$pkgdir/usr/share/okular-mupdf-ng/Allura-Regular.ttf"
  test -f "$pkgdir/usr/share/doc/okular-mupdf-ng/Allura-OFL.txt"
  test -f "$pkgdir/usr/share/doc/okular-mupdf-ng/MuPDF-COPYING"
}
