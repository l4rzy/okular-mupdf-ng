# Maintainer: rzy <me@23ro.org>
pkgbase=okular-mupdf-ng-dynamic
pkgname=okular-mupdf-ng-dynamic
_pkgname=okular-mupdf-ng
pkgver=0.6.3
pkgrel=1
pkgdesc="Secure and fast MuPDF-based Okular backend for PDF, ePUB, MOBI, AZW3, KFX, and XPS"
arch=('x86_64')
url="https://github.com/l4rzy/okular-mupdf-ng"
license=('AGPL-3.0-or-later AND GPL-3.0-or-later AND OFL-1.1')
# The system MuPDF pulls its third-party libraries in transitively.
depends=('okular' 'qt6-base' 'nss' 'libseccomp' 'libmupdf')
# Keep cargo unversioned so rustup can provide it; Cargo enforces rust-version.
makedepends=('cmake>=3.20' 'extra-cmake-modules>=6.3.0' 'gcc' 'gettext' 'git'
             'make' 'mupdf' 'ninja' 'pkgconf' 'python' 'qt6-tools' 'cargo')
checkdepends=('openssl' 'tesseract-data-eng' 'ttf-dejavu')
provides=('okular-mupdf-ng')
conflicts=('okular-mupdf-ng' 'okular-mupdf-ng-git')
source=("$_pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cmake -B "$srcdir/build" -S "$srcdir/$_pkgname" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKDE_INSTALL_LIBDIR=lib \
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
    -DUSE_SYSTEM_MUPDF=ON \
    -DBUILD_TESTING=ON \
    -DTESSDATA_DIR=/usr/share/tessdata
  cmake --build "$srcdir/build"
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir "$srcdir/build" --output-on-failure --parallel 4
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  # The signature appearance depends on the bundled font; fail the package
  # rather than silently shipping a build whose install rule dropped it.
  test -f "$pkgdir/usr/share/okular-mupdf-ng/Allura-Regular.ttf"
  test -f "$pkgdir/usr/share/doc/okular-mupdf-ng/Allura-OFL.txt"
  test -f "$pkgdir/usr/share/doc/okular-mupdf-ng/MuPDF-COPYING"
}
