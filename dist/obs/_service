<services>
  <!-- Create the tar archive directly; the service host does not provide tar. -->
  <service name="tar_scm" mode="serveronly">
    <param name="url">https://github.com/l4rzy/okular-mupdf-ng.git</param>
    <param name="scm">git</param>
    <param name="revision">@PARENT_TAG@</param>
    <param name="match-tag">v*</param>
    <param name="filename">okular-mupdf-ng</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">^v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>

    <!-- RPM packaging -->
    <param name="extract">dist/obs/okular-mupdf-ng.spec</param>
    <param name="extract">dist/obs/okular-mupdf-ng.changes</param>

    <!-- Debian/Ubuntu packaging -->
    <param name="extract">dist/obs/okular-mupdf-ng.dsc</param>
    <param name="extract">dist/obs/debian.changelog</param>
    <param name="extract">dist/obs/debian.clean</param>
    <param name="extract">dist/obs/debian.control</param>
    <param name="extract">dist/obs/debian.copyright</param>
    <param name="extract">dist/obs/debian.docs</param>
    <param name="extract">dist/obs/debian.rules</param>

    <!-- Arch Linux packaging -->
    <param name="extract">dist/obs/PKGBUILD</param>
  </service>

  <service name="recompress" mode="serveronly">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>

  <!-- Generate vendor.tar.gz with python3 scripts/vendor-boko.py from the
       matching source checkout, then upload it. -->
  <service name="cargo_vendor" mode="manual">
    <param name="src">*okular-mupdf-ng-*.tar.gz</param>
    <param name="cargotoml">src/worker/engine/kindle/Cargo.toml</param>
    <param name="update">false</param>
    <param name="respect-lockfile">true</param>
    <param name="compression">gz</param>
  </service>

  <!-- set_version replaces PKGBUILD checksums with SKIP, so only update RPM
       and Debian metadata. OBS prefixes outputs before passing them to the
       next service. Keep PKGBUILD's pkgver aligned with release tags. -->
  <service name="set_version" mode="serveronly">
    <param name="file">_service:tar_scm:okular-mupdf-ng.spec</param>
    <param name="file">_service:tar_scm:okular-mupdf-ng.dsc</param>
    <param name="file">_service:tar_scm:debian.changelog</param>
  </service>
  <!-- Fetch only MuPDF; the project archive is generated by tar_scm. -->
  <service name="download_url" mode="serveronly">
    <param name="url">https://github.com/ArtifexSoftware/mupdf-downloads/releases/download/1.28.5/mupdf-1.28.5-source.tar.gz</param>
    <param name="filename">mupdf-1.28.5-source.tar.gz</param>
  </service>
</services>
