#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later

include /usr/share/dpkg/architecture.mk

export CC = gcc
export CXX = g++
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export QT_QPA_PLATFORM = offscreen
export CARGO_NET_OFFLINE = true

BUILD_DIR = build-debian
MUPDF_VERSION := $(shell sed -n '1p' cmake/mupdf.version)
MUPDF_SHA256 := $(shell sed -n '2p' cmake/mupdf.version)
MUPDF_ARCHIVE = mupdf-$(MUPDF_VERSION)-source.tar.gz
MUPDF_SOURCE_DIR = $(CURDIR)/$(BUILD_DIR)/mupdf-source
BUILD_TESTING = $(if $(filter nocheck,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)),OFF,ON)

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=$(BUILD_DIR)

override_dh_auto_configure:
	rustc --version
	cargo --version
	printf '%s  %s\n' '$(MUPDF_SHA256)' '$(MUPDF_ARCHIVE)' | sha256sum --check --status
	mkdir -p '$(MUPDF_SOURCE_DIR)'
	tar -xzf '$(MUPDF_ARCHIVE)' --strip-components=1 -C '$(MUPDF_SOURCE_DIR)'
	tar -xzf vendor.tar.gz
	dh_auto_configure --builddirectory=$(BUILD_DIR) -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_COMPILER=gcc \
		-DCMAKE_CXX_COMPILER=g++ \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DKDE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
		-DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
		-DUSE_SYSTEM_MUPDF=OFF \
		-DMUPDF_SOURCE_DIR:PATH='$(MUPDF_SOURCE_DIR)' \
		-DENABLE_LTO=OFF \
		-DBUILD_TESTING=$(BUILD_TESTING) \
		-DENABLE_BUILD_TREE_WORKER=OFF \
		-DENABLE_MU_DEBUG=OFF \
		-DDISABLE_WORKER_SANDBOX=OFF \
		-DTESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

override_dh_auto_test:
ifeq ($(BUILD_TESTING),ON)
	dh_auto_test --builddirectory=$(BUILD_DIR)
else
	:
endif

override_dh_auto_install:
	dh_auto_install --builddirectory=$(BUILD_DIR) --destdir=debian/okular-mupdf-ng

override_dh_clean:
	dh_clean
	# Record the binary source archives supplied through Debtransform-Files.
	mkdir -p debian/source
	printf '%s\n' '$(MUPDF_ARCHIVE)' vendor.tar.gz > debian/source/include-binaries
