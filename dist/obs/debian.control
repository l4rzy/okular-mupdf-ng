 gcc,
 g++,
 cmake (>= 3.20),
 extra-cmake-modules (>= 6.3.0),
 gettext,
 ninja-build,
 patch,
 pkg-config,
 python3 (>= 3.12),
 libavcodec-extra,
 libavformat-extra,
 libbrotli-dev,
 libfreetype-dev,
 libjpeg-dev,
 libkf6config-dev,
 libkf6configwidgets-dev,
 libkf6coreaddons-dev,
