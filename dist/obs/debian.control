Source: okular-mupdf-ng
Section: utils
Priority: optional
Maintainer: l4rzy <me@23ro.org>
Build-Depends: debhelper-compat (= 13),
 gcc,
 g++,
 cargo-web (>= 1.91) | cargo (>= 1.91),
 rustc-web (>= 1.91) | rustc (>= 1.91),
 cmake (>= 3.20),
 extra-cmake-modules (>= 6.3.0),
 gettext,
 ninja-build,
 patch,
 pkg-config,
 python3 (>= 3.12),
 libavcodec-extra,
 libavformat-extra,
 libbrotli-dev,
 libfreetype-dev,
 libjpeg-dev,
 libkf6config-dev,
 libkf6configwidgets-dev,
 libkf6coreaddons-dev,
 libkf6i18n-dev,
 libkf6kio-dev,
 libkf6widgetsaddons-dev,
 libkf6xmlgui-dev,
 libnss3-dev,
 libseccomp-dev,
 libselinux1-dev,
 okular-dev,
 qt6-base-dev,
 zlib1g-dev,
 fonts-dejavu-core,
 libnss3-tools,
 openssl,
 tesseract-ocr-eng
Standards-Version: 4.7.0
Rules-Requires-Root: no
Homepage: https://github.com/l4rzy/okular-mupdf-ng

Package: okular-mupdf-ng
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}, okular
Recommends: tesseract-ocr-eng
Description: Secure and fast MuPDF-based backend for Okular
 Supports PDF, ePUB, legacy MOBI, and DRM-free AZW3 and single-container KFX.
 Document parsing, rendering, and OCR run in a separate sandboxed worker.
 Includes the mupdfng-cli command-line utility.
