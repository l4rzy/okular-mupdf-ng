+/* Measure the wrapped layout with the same line breaker used for drawing.
+ * CRLF is one break; trailing breaks reserve an empty editable line. */
+static int
+multiline_text_fits(fz_context *ctx, fz_text_language lang, fz_font *font,
+	const char *text, float size, float w, float h, float lineheight)
+{
+	const char *end;
+	int lines = 0;
+	do
+	{
+		if (break_string(ctx, lang, font, size, text, &end, w) > w)
+			return 0;
+		++lines;
+		if (end > text && end[-1] == '\r' && end[0] == '\n')
+			++end;
+		if (!*end && end > text && (end[-1] == '\r' || end[-1] == '\n'))
+			++lines;
+		if (lines * size * lineheight > h)
+			return 0;
+		text = end;
+	}
+	while (*text);
+	return 1;
+}
+
+static float
+auto_multiline_text_size(fz_context *ctx, fz_text_language lang, fz_font *font,
+	const char *text, float w, float h, float lineheight)
+{
+	float lo = 0.1f, hi = 12;
+	int i;
+	if (w <= 0 || h <= 0)
+		return lo;
+	if (multiline_text_fits(ctx, lang, font, text, hi, w, h, lineheight))
+		return hi;
+	/* Bound the work while keeping the fitted size within 0.001 point. */
+	for (i = 0; i < 16; ++i)
+	{
+		float size = (lo + hi) * 0.5f;
+		if (multiline_text_fits(ctx, lang, font, text, size, w, h, lineheight))
+			lo = size;
+		else
+			hi = size;
+	}
+	return lo;
+}
