+/* Restrict each line to the free interval beside image margin boxes. */
+static void float_line_bounds(layout_data *ld, float y, float h, float *left, float *right, float *bottom)
+{
+	fz_html_box *image;
+	*left = ld->bounds[L];
+	*right = ld->bounds[R];
+	*bottom = y;
+	for (image = ld->floats; image; image = image->next_float)
+	{
+		fz_rect r = image->float_bounds;
+		if (y >= r.y1)
+			break;
+		if (y < r.y1 && y + h > r.y0)
