+static int can_float_image(layout_data *ld, fz_html_box *box)
+{
+	fz_html_box *ancestor;
+	fz_html_flow *node;
+	if (ld->restart || !box->is_image_block || !box->style->float_side)
+		return 0;
+	for (ancestor = box; ancestor; ancestor = ancestor->up)
+		if (ancestor->type == BOX_TABLE || ancestor->type == BOX_TABLE_ROW ||
+			ancestor->type == BOX_TABLE_CELL || ancestor->style->position != POS_STATIC)
+			return 0;
+	if (!box->down || box->down->type != BOX_FLOW)
+		return 0;
+	for (node = box->down->u.flow.head; node; node = node->next)
+		if (node->type == FLOW_IMAGE)
+			return 1;
+	return 0;
+}
