+static int
+match_att_substring_condition(fz_xml *node, const char *key, const char *val, int type)
+{
+	const char *att = fz_xml_att(node, key);
+	size_t n = strlen(val);
+	size_t len;
+
+	if (!att)
+		return 0;
+	/* Unlike substring selectors, |= permits an empty value. */
+	if (type == '|')
+		return !strncmp(att, val, n) && (att[n] == 0 || att[n] == '-');
+	if (!n)
+		return 0;
+	switch (type)
+	{
+	case '^': return !strncmp(att, val, n);
+	case '$':
+		len = strlen(att);
+		return len >= n && !strcmp(att + len - n, val);
+	case '*': return strstr(att, val) != NULL;
 	}
 	return 0;
 }
