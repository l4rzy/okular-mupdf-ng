+static void
+skip_calc_space(const char **p)
+{
+	const char *end;
+	for (;;)
+	{
+		*p += strspn(*p, " \t\r\n\f");
+		if ((*p)[0] != '/' || (*p)[1] != '*')
+			return;
+		end = strstr(*p + 2, "*/");
+		if (!end)
+		{
+			*p += strlen(*p);
+			return;
+		}
+		*p = end + 2;
+	}
+}
+
+static int
+finite_calc(css_calc_value *v)
+{
+	int i;
+	for (i = 0; i < 8; ++i)
+		if (!isfinite(v->term[i]))
+			return 0;
+	return 1;
+}
+
+static int parse_calc_sum(css_calc_parser *parser, int depth, css_calc_value *v);
