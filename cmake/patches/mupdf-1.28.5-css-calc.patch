+/* Read calc() separately: the ordinary value grammar treats + and - as signs,
+ * not binary operators. Keep the expression intact for typed numeric validation. */
+static fz_css_value *parse_calc(struct lexbuf *buf)
+{
+	int depth = 1, closed = 0;
+	fz_css_value *args;
+	buf->string_len = 0;
+	while (buf->c && buf->c != ';' && buf->c != '}')
+	{
+		if (buf->c == '/' && *buf->s == '*')
+		{
+			css_lex_next(buf);
+			css_lex_next(buf);
+			while (buf->c && !(buf->c == '*' && *buf->s == '/'))
+				css_lex_next(buf);
+			if (!buf->c) break;
+			css_lex_next(buf);
+			css_lex_next(buf);
+			css_push_char(buf, ' ');
+			continue;
+		}
+		if (buf->c == '(')
+			++depth;
+		if (buf->c == ')' && --depth == 0)
+		{
+			closed = 1;
+			css_lex_next(buf);
+			break;
+		}
+		css_push_char(buf, buf->c);
+		css_lex_next(buf);
+	}
+	css_push_zero(buf);
+	args = fz_new_css_value(buf->ctx, buf->pool, closed ? CSS_STRING : CSS_KEYWORD, buf->string);
+	next(buf);
+	return args;
+}
