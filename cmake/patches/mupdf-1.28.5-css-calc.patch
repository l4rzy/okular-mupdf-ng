+static int
+parse_calc_number(fz_css_value *value, fz_css_number *number)
+{
+	css_calc_parser parser;
+	css_calc_value result;
+	int i;
+	if (!value->args || value->args->type != CSS_STRING)
+		return 0;
+	parser.p = value->args->data;
+	parser.terms = 0;
+	if (!parse_calc_sum(&parser, 0, &result))
+		return 0;
+	skip_calc_space(&parser.p);
+	if (*parser.p)
+		return 0;
+	*number = make_number(result.term[0], result.scalar ? N_NUMBER : N_CALC);
+	for (i = 0; i < 7; ++i)
+		number->calc[i] = result.term[i+1];
+	return 1;
+}
