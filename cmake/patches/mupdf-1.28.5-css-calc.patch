+#define CALC_UNIT(s) (len == sizeof(s)-1 && !fz_strncasecmp(unit, s, len))
+	if (!len) v->scalar = 1;
+	else if (CALC_UNIT("pt") || CALC_UNIT("px")) { }
+	else if (CALC_UNIT("in")) x *= 72;
+	else if (CALC_UNIT("cm")) x *= 7200.0f / 254;
+	else if (CALC_UNIT("mm")) x *= 720.0f / 254;
+	else if (CALC_UNIT("q")) x *= 180.0f / 254;
+	else if (CALC_UNIT("pc")) x *= 12;
+	else if (CALC_UNIT("em")) slot = 1;
+	else if (CALC_UNIT("ex") || CALC_UNIT("ch")) { slot = 1; x *= .5f; }
+	else if (CALC_UNIT("rem")) slot = 2;
+	else if (CALC_UNIT("%")) slot = 3;
+	else if (CALC_UNIT("vw")) slot = 4;
+	else if (CALC_UNIT("vh")) slot = 5;
+	else if (CALC_UNIT("vmin")) slot = 6;
+	else if (CALC_UNIT("vmax")) slot = 7;
+	else return 0;
+#undef CALC_UNIT
+	v->term[slot] = x;
+	return finite_calc(v);
+}
+
+static int
+parse_calc_product(css_calc_parser *parser, int depth, css_calc_value *v)
+{
+	css_calc_value rhs;
+	const char *p;
+	float scale;
+	int op, i;
+	if (!parse_calc_atom(parser, depth, v))
+		return 0;
+	for (;;)
+	{
+		p = parser->p;
+		skip_calc_space(&p);
+		op = *p;
+		if (op != '*' && op != '/')
+			return 1;
+		parser->p = p + 1;
+		if (!parse_calc_atom(parser, depth, &rhs))
+			return 0;
+		if (op == '/')
+		{
+			if (!rhs.scalar || rhs.term[0] == 0)
+				return 0;
+			scale = 1 / rhs.term[0];
+		}
+		else if (rhs.scalar)
+			scale = rhs.term[0];
+		else if (v->scalar)
+		{
+			scale = v->term[0];
+			*v = rhs;
+		}
+		else return 0;
+		for (i = 0; i < 8; ++i)
+			v->term[i] *= scale;
+		if (!finite_calc(v))
+			return 0;
+	}
+}
+
+static int
+parse_calc_sum(css_calc_parser *parser, int depth, css_calc_value *v)
+{
+	css_calc_value rhs;
+	const char *p, *after;
+	int op, i;
+	if (!parse_calc_product(parser, depth, v))
+		return 0;
+	for (;;)
+	{
+		p = parser->p;
+		skip_calc_space(&p);
+		op = *p;
+		if (op != '+' && op != '-')
+			return 1;
+		/* Binary + and - require whitespace on both sides. */
+		after = p + 1;
+		skip_calc_space(&after);
+		if (p == parser->p || after == p + 1)
+			return 0;
+		parser->p = after;
+		if (!parse_calc_product(parser, depth, &rhs) || rhs.scalar != v->scalar)
+			return 0;
+		for (i = 0; i < 8; ++i)
+			v->term[i] += op == '+' ? rhs.term[i] : -rhs.term[i];
+		if (!finite_calc(v))
+			return 0;
+	}
+}
