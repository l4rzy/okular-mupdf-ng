+static int
+parse_calc_atom(css_calc_parser *parser, int depth, css_calc_value *v)
+{
+	const char *unit;
+	char *end;
+	float x;
+	size_t len;
+	int slot = 0;
+	memset(v, 0, sizeof *v);
+	skip_calc_space(&parser->p);
+	if (depth > 32 || ++parser->terms > 128)
+		return 0;
+	if (*parser->p == '(' || !fz_strncasecmp(parser->p, "calc(", 5))
+	{
+		parser->p += *parser->p == '(' ? 1 : 5;
+		if (!parse_calc_sum(parser, depth + 1, v))
+			return 0;
+		skip_calc_space(&parser->p);
+		if (*parser->p != ')')
+			return 0;
+		++parser->p;
+		return 1;
+	}
+	if (!strchr("+-.0123456789", *parser->p) || !*parser->p)
+		return 0;
+	x = fz_strtof(parser->p, &end);
+	if (end == parser->p || !isfinite(x))
+		return 0;
+	parser->p = unit = end;
+	while ((*parser->p >= 'a' && *parser->p <= 'z') || (*parser->p >= 'A' && *parser->p <= 'Z'))
+		++parser->p;
+	if (*parser->p == '%')
+		++parser->p;
