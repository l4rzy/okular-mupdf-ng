+fz_outline *
+fz_load_mobi_outline(fz_context *ctx, fz_buffer *buffer)
+{
+	fz_xml *xml = NULL, *node, *start = NULL;
+	fz_tree *targets = NULL;
+	fz_outline *head = NULL, *last = NULL;
+	fz_outline **tails[65];
+	int levels[65], level = 0, depth;
+	size_t count = 0;
+	fz_buffer *label = NULL;
+	char target[64];
+	uint32_t position;
+	fz_var(xml);
+	fz_var(targets);
+	fz_var(head);
+	fz_var(label);
+	fz_try(ctx)
+	{
+		xml = fz_parse_xml_from_html5(ctx, buffer);
+		for (node = fz_xml_root(xml); node; node = mobi_next_xml(node, NULL))
+		{
+			const char *id = fz_xml_att(node, "id");
+			if (id && !strncmp(id, "mupdf-mobi-", 11))
+				targets = fz_tree_insert(ctx, targets, id, node);
+		}
+		for (node = fz_xml_root(xml); node; node = mobi_next_xml(node, NULL))
+			if (fz_xml_is_tag(node, "reference") && fz_xml_att_eq(node, "type", "toc")
+				&& fz_parse_mobi_filepos(fz_xml_att(node, "filepos"), &position))
+			{
+				fz_snprintf(target, sizeof target, "mupdf-mobi-%u", position);
+				start = fz_tree_lookup(ctx, targets, target);
+				/* A guide may point at the first link itself. Its inserted
+				 * marker is inside that link, so include the enclosing entry. */
+				for (node = fz_xml_up(start); node; node = fz_xml_up(node))
+					if (fz_xml_is_tag(node, "a"))
+					{
+						start = node;
+						break;
+					}
+				break;
+			}
+		tails[0] = &head;
+		levels[0] = 0;
+		label = fz_new_buffer(ctx, 128);
+		for (node = start; node; node = mobi_next_xml(node, NULL))
+		{
+			fz_xml *child, *parent;
+			const char *uri;
+			int space = 0;
+			if (fz_xml_is_tag(node, "pagebreak"))
+				break;
+			if (!fz_xml_is_tag(node, "a"))
+				continue;
+			uri = fz_xml_att(node, "href");
+			if (fz_parse_mobi_filepos(fz_xml_att(node, "filepos"), &position))
+			{
+				fz_snprintf(target, sizeof target, "mupdf-mobi-%u", position);
+				if (!fz_tree_lookup(ctx, targets, target))
+					continue;
+				fz_snprintf(target, sizeof target, "#mupdf-mobi-%u", position);
+				uri = target;
+			}
+			if (!uri || uri[0] != '#')
+				continue;
+			fz_clear_buffer(ctx, label);
+			for (child = fz_xml_down(node); child; child = mobi_next_xml(child, node))
+			{
+				const unsigned char *text = (const unsigned char *)fz_xml_text(child);
+				if (text)
+				{
+					for (; *text; ++text)
+						if (*text == ' ' || *text == '\n' || *text == '\r' || *text == '\t')
+							space = label->len != 0;
+						else
+						{
+							if (space) fz_append_byte(ctx, label, ' ');
+							space = 0;
+							fz_append_byte(ctx, label, *text);
+							if (label->len > 65536)
+								fz_throw(ctx, FZ_ERROR_LIMIT, "MOBI outline title limit exceeded");
+						}
+				}
+			}
+			if (!label->len)
+				continue;
+			depth = 0;
+			for (parent = fz_xml_up(node); parent; parent = fz_xml_up(parent))
+				if (fz_xml_is_tag(parent, "ul") || fz_xml_is_tag(parent, "ol") || fz_xml_is_tag(parent, "blockquote"))
+					++depth;
+			if (depth > 64 || ++count > 50000)
+				fz_throw(ctx, FZ_ERROR_LIMIT, "MOBI outline limit exceeded");
+			/* Reconsider descent after popping a skipped nesting level.
+			 * Keep the parent's child tail so existing children are retained. */
+			while (level && depth < levels[level]) --level;
+			if (head && depth > levels[level]) ++level;
+			levels[level] = depth;
+			last = fz_new_outline(ctx);
+			*tails[level] = last;
+			tails[level] = &last->next;
+			if (level < 64) tails[level+1] = &last->down;
+			last->title = fz_strdup(ctx, fz_string_from_buffer(ctx, label));
+			last->uri = fz_strdup(ctx, uri);
+			last->is_open = 1;
+		}
+	}
+	fz_always(ctx)
+	{
+		fz_drop_xml(ctx, xml);
+		fz_drop_tree(ctx, targets, NULL);
+		fz_drop_buffer(ctx, label);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_outline(ctx, head);
+		fz_rethrow_if(ctx, FZ_ERROR_SYSTEM);
+		fz_rethrow_if(ctx, FZ_ERROR_TRYLATER);
+		fz_report_error(ctx);
+		return NULL;
+	}
+	return head;
+}
