 #define TEXT_ENCODING_1252 1252
 #define TEXT_ENCODING_UTF8 65001
 
+/* filepos counts bytes in the original, decompressed text, before transcoding. */
+int
+fz_parse_mobi_filepos(const char *text, uint32_t *position)
+{
+	uint32_t value = 0;
+	if (!text || !*text)
+		return 0;
+	for (; *text; ++text)
+	{
+		unsigned digit = (unsigned char)*text - '0';
+		if (digit > 9 || value > (UINT32_MAX - digit) / 10)
+			return 0;
+		value = value * 10 + digit;
+	}
+	*position = value;
+	return 1;
+}
+
+/* Iterative traversal also keeps deeply nested input off the C stack. */
+static fz_xml *
+mobi_next_xml(fz_xml *node, fz_xml *top)
+{
+	if (fz_xml_down(node))
+		return fz_xml_down(node);
+	while (node && node != top)
+	{
+		if (fz_xml_next(node))
+			return fz_xml_next(node);
+		node = fz_xml_up(node);
+	}
+	return NULL;
+}
+
+static int
+compare_mobi_positions(const void *a, const void *b)
+{
+	uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+	return (x > y) - (x < y);
+}
+
+/* Raw-text/RCDATA elements cannot contain inserted HTML anchor markup. */
+static const char *
+mobi_raw_tag(const unsigned char *text, size_t len)
+{
+	static const char *tags[] = { "script", "style", "title", "textarea", "xmp", "iframe", "noembed", "noframes", "plaintext" };
+	int i;
+	for (i = 0; i < (int)(sizeof(tags) / sizeof(tags[0])); ++i)
+	{
+		size_t n = strlen(tags[i]);
+		if (len > n && !fz_strncasecmp((const char *)text, tags[i], n) &&
+			(text[n] == '>' || text[n] == '/' || (text[n] && strchr(" \t\r\n\f", text[n]))))
+			return tags[i];
+	}
+	return NULL;
+}
+
+static void
+mobi_add_targets(fz_context *ctx, fz_buffer *buffer, int encoding)
+{
+	fz_xml *xml = NULL, *node;
+	fz_buffer *out = NULL;
+	uint32_t *positions = NULL, position;
+	size_t count = 0, index = 0, i;
+	int in_tag = 0, quote = 0, in_entity = 0, in_comment = 0;
+	const char *raw = NULL;
+	fz_var(xml);
+	fz_var(out);
+	fz_var(positions);
+	fz_try(ctx)
+	{
+		xml = fz_parse_xml_from_html5(ctx, buffer);
+		positions = fz_malloc_array(ctx, 50000, uint32_t);
+		for (node = fz_xml_root(xml); node; node = mobi_next_xml(node, NULL))
+		{
+			if (fz_parse_mobi_filepos(fz_xml_att(node, "filepos"), &position) && position < buffer->len)
+			{
+				if (count == 50000)
+					fz_throw(ctx, FZ_ERROR_LIMIT, "too many MOBI destinations");
+				positions[count++] = position;
+			}
+		}
+		qsort(positions, count, sizeof(*positions), compare_mobi_positions);
+		if (count)
+		{
+			out = fz_new_buffer(ctx, buffer->len);
+			for (i = 0; i < buffer->len; ++i)
+			{
+				int c = buffer->data[i];
+				if (raw && !in_tag && c == '<' && buffer->len - i > 2 && buffer->data[i+1] == '/' &&
+					strcmp(raw, "plaintext") && mobi_raw_tag(buffer->data + i + 2, buffer->len - i - 2) == raw)
+				{
+					raw = NULL;
+					in_tag = 1;
+				}
+				/* If a bad offset lands in markup, an entity, or a UTF-8
+				 * sequence, wait for a safe insertion point. */
+				if (!in_tag && !in_entity && !in_comment && !raw && c != '<' &&
+					(encoding != TEXT_ENCODING_UTF8 || (c & 0xc0) != 0x80))
+					while (index < count && positions[index] <= i)
+					{
+						position = positions[index++];
+						fz_append_printf(ctx, out, "<span id=\"mupdf-mobi-%u\"></span>", position);
+						while (index < count && positions[index] == position)
+							++index;
+					}
+				fz_append_byte(ctx, out, c);
+				if (in_comment)
+				{
+					/* Match the HTML5 parser's tolerated --!> close too. */
+					if (c == '>' && ((i >= 2 && buffer->data[i-2] == '-' && buffer->data[i-1] == '-') ||
+						(i >= 3 && buffer->data[i-3] == '-' && buffer->data[i-2] == '-' && buffer->data[i-1] == '!')))
+						in_comment = 0;
+				}
+				else if (in_tag)
+				{
+					if (quote && c == quote) quote = 0;
+					else if (!quote && (c == '\'' || c == '"')) quote = c;
+					else if (!quote && c == '>') in_tag = 0;
+				}
+				else if (raw) { } /* HTML5 raw text ignores markup other than its end tag. */
+				else if (c == '<' && buffer->len - i >= 4 && !memcmp(buffer->data + i, "<!--", 4))
+					in_comment = 1;
+				else if (c == '<')
+				{
+					in_tag = 1;
+					raw = mobi_raw_tag(buffer->data + i + 1, buffer->len - i - 1);
+				}
+				else if (c == '&') in_entity = 1;
+				else if (in_entity && (c == ';' || strchr(" \t\r\n\f", c))) in_entity = 0;
+			}
+			fz_clear_buffer(ctx, buffer);
+			fz_append_buffer(ctx, buffer, out);
+		}
+	}
+	fz_always(ctx)
+	{
+		fz_drop_xml(ctx, xml);
+		fz_drop_buffer(ctx, out);
+		fz_free(ctx, positions);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+}
