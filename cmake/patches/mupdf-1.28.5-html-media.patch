+/* No viewport feature evaluator is available while stylesheets load. Unknown
+ * conditions do not match; in particular, print queries must not hide screen
+ * content merely because they contain whitespace or parentheses. */
+static int
+html_matches_media_type(const char *start, const char *end)
+{
+	const char *word;
+	size_t len;
+	int negate = 0, matches;
+	start += strspn(start, " \t\r\n\f");
+	word = start;
+	while (start < end && ((*start >= 'a' && *start <= 'z') || (*start >= 'A' && *start <= 'Z') || *start == '-'))
+		++start;
+	len = start - word;
+	if ((len == 3 && !fz_strncasecmp(word, "not", 3)) ||
+		(len == 4 && !fz_strncasecmp(word, "only", 4)))
+	{
+		negate = len == 3;
+		if (start == end || !strchr(" \t\r\n\f", *start))
+			return 0;
+		start += strspn(start, " \t\r\n\f");
+		word = start;
+		while (start < end && ((*start >= 'a' && *start <= 'z') || (*start >= 'A' && *start <= 'Z') || *start == '-'))
+			++start;
+		len = start - word;
+	}
+	if (!len || (len == 3 && !fz_strncasecmp(word, "not", 3)) ||
+		(len == 4 && !fz_strncasecmp(word, "only", 4)))
+		return 0;
+	while (start < end && strchr(" \t\r\n\f", *start))
+		++start;
+	if (start != end)
+		return 0;
+	matches = (len == 6 && !fz_strncasecmp(word, "screen", 6)) ||
+		(len == 3 && !fz_strncasecmp(word, "all", 3));
+	return negate ? !matches : matches;
+}
+
+static int
+html_matches_media(const char *media)
+{
+	const char *start, *p;
+	size_t depth = 0;
+	int quote = 0;
+	if (!media || !media[strspn(media, " \t\r\n\f")])
+		return 1;
+	start = media;
+	for (p = media; ; ++p)
+	{
+		if (!*p || (*p == ',' && !depth && !quote))
+		{
+			if (html_matches_media_type(start, p))
+				return 1;
+			if (!*p)
+				return 0;
+			start = p + 1;
+		}
+		else if (quote)
+		{
+			if (*p == '\\' && p[1]) ++p;
+			else if (*p == quote) quote = 0;
+		}
+		else if (*p == '\'' || *p == '"') quote = *p;
+		else if (*p == '(') ++depth;
+		else if (*p == ')' && depth) --depth;
+	}
+}
