+/* Match simple CSS media lists for screen display. Keep the existing behavior
+ * for complex media queries until a media query evaluator is available. */
+static int
+html_matches_media(const char *media)
+{
+	const char *end;
+	size_t len;
+
+	if (!media || !media[strspn(media, " \t\r\n\f")])
+		return 1;
+	while (*media)
+	{
+		media += strspn(media, " \t\r\n\f");
+		end = strchr(media, ',');
+		if (!end)
+			end = media + strlen(media);
+		len = end - media;
+		while (len && strchr(" \t\r\n\f", media[len-1]))
+			--len;
+		if ((len == 6 && !fz_strncasecmp(media, "screen", len)) ||
+			(len == 3 && !fz_strncasecmp(media, "all", len)))
+			return 1;
+		/* Whitespace within an entry or parentheses indicate a complex query. */
+		if (strcspn(media, " \t\r\n\f()") < len)
+			return 1;
+		media = *end ? end + 1 : end;
+	}
+	return 0;
+}
