+/* Image top relative to the baseline. Top/bottom alignment is relative to the
+ * completed line box and is handled separately in measurement and placement. */
+static float image_baseline_offset(fz_html_flow *node)
+{
+	float em = node->box->s.layout.em;
+	switch (node->box->style->vertical_align)
+	{
+	default:
+	case VA_BASELINE:
+		return -node->h;
+	case VA_SUB:
+		return -node->h + em / 5;
+	case VA_SUPER:
+		return -node->h - em / 3;
+	case VA_MIDDLE:
+		return -em * 0.25f - node->h * 0.5f;
+	case VA_TEXT_TOP:
+		return -em * 0.8f;
+	case VA_TEXT_BOTTOM:
+		return em * 0.2f - node->h;
+	case VA_PERCENT:
+	case VA_LENGTH:
+		return -node->h - fz_from_css_number(
+			node->box->style->vertical_align_number, em,
+			fz_from_css_number_scale(node->box->style->line_height, em, node->box->s.layout.rem), 0, node->box->s.layout.rem);
+	}
