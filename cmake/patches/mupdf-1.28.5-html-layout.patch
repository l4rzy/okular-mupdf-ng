+/* Find the last in-flow line; empty inline blocks use their bottom margin edge. */
+static void find_inline_baseline(fz_html_box *box, float *baseline)
+{
+	fz_html_box *child;
+	if (box->type == BOX_FLOW)
+	{
+		fz_html_flow *node;
+		for (node = box->u.flow.head; node; node = node->next)
+		{
+			if (node->type == FLOW_WORD || node->type == FLOW_SPACE || node->type == FLOW_SHYPHEN)
+				*baseline = node->y;
+			else if (node->type == FLOW_BLOCK)
+				*baseline = node->y + node->box->inline_baseline;
+		}
+		return;
+	}
+	for (child = box->down; child; child = child->next)
+		if (child->style->position != POS_FIXED && child->style->position != POS_ABSOLUTE)
+			find_inline_baseline(child, baseline);
+}
