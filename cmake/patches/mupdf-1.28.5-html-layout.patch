+/* An inline block has its own formatting context and moves between lines as
+ * one object. Lay it out continuously first, then position its margin box. */
+static void layout_inline_block(fz_context *ctx, layout_data *ld, fz_html_flow *node)
+{
+	fz_html_box *block = node->box;
+	layout_data local = *ld;
+	float spacing = block_padding(ctx, block);
+	float available = fz_max(0, ld->bounds[R] - ld->bounds[L]);
+	float width = available;
+	if (!fz_css_number_defined_not_auto(block->style->width))
+	{
