+	case VA_TEXT_TOP: return -em * 0.8f;
+	case VA_TEXT_BOTTOM: return em * 0.2f - node->h;
+	case VA_PERCENT:
+	case VA_LENGTH:
+		return -node->box->inline_baseline - fz_from_css_number(
+			node->box->style->vertical_align_number, em,
