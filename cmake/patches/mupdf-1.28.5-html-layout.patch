+ * not the tentative width or the space remaining after margins and padding. */
+static float constrain_css_width(fz_html_box *box, float width, float containing_width)
+{
+	float limit = fz_from_css_number(box->style->max_width, box->s.layout.em,
+		containing_width, width, box->s.layout.rem);
+	return limit >= 0 ? fz_min(width, limit) : width;
