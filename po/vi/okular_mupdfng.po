msgstr ""
"Chọn phông chữ cơ bản cho văn bản EPUB. Mặc định dùng phông chữ của tài liệu."

#: src/generator/config/settingswidget.cpp:249
msgid "Choose the page dimensions used to lay out EPUB content."
msgstr "Chọn kích thước trang để dàn nội dung EPUB."

#: src/generator/config/settingswidget.cpp:251
msgid "Customize EPUB appearance with CSS rules."
msgstr "Tùy chỉnh cách hiển thị EPUB bằng các quy tắc CSS."

