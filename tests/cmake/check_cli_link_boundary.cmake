find_program(LDD_EXECUTABLE ldd REQUIRED)
function(check_dependencies executable forbidden)
    execute_process(COMMAND "${LDD_EXECUTABLE}" "${executable}"
        RESULT_VARIABLE status OUTPUT_VARIABLE dependencies ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect dependencies of ${executable}: ${error}")
    endif()
    if(dependencies MATCHES "${forbidden}")
        message(FATAL_ERROR "${executable} has a forbidden runtime dependency:\n${dependencies}")
    endif()
endfunction()

check_dependencies("${CLI_PATH}" "lib(KF[0-9]|Okular|paperbox|mupdf)")
check_dependencies("${WORKER_PATH}" "lib(Qt[0-9]|Okular|KF[0-9]|paperbox)")
if(DEFINED PLUGIN_PATH)
    check_dependencies("${PLUGIN_PATH}" "lib(paperbox|mupdf)")
    find_program(NM_EXECUTABLE nm REQUIRED)
    execute_process(COMMAND "${NM_EXECUTABLE}" --dynamic --defined-only --demangle "${PLUGIN_PATH}"
        RESULT_VARIABLE status OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect exports of ${PLUGIN_PATH}: ${error}")
    endif()
    if(symbols MATCHES " [TDBR] paperbox::[^\n]*")
        message(FATAL_ERROR "${PLUGIN_PATH} exports a Paperbox symbol: ${CMAKE_MATCH_0}")
    endif()
endif()

file(GLOB cli_sources "${CLI_SOURCE_DIR}/*.cpp" "${CLI_SOURCE_DIR}/*.hpp")
foreach(source IN LISTS cli_sources)
    file(READ "${source}" contents)
    if(contents MATCHES "#[ \t]*include[ \t]*[<\"](generator/|KConfig|KSharedConfig|okular/)")
        message(FATAL_ERROR "CLI source depends on generator/KDE/Okular: ${source}")
    endif()
    if(contents MATCHES "#[ \t]*include[ \t]*[<\"]internal/")
        message(FATAL_ERROR "CLI source includes a private Paperbox header: ${source}")
    endif()
endforeach()
