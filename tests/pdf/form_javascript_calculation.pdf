<< /Type /Annot /Subtype /Widget /FT /Tx /T (Total) /V (53.87) /Rect [250 69 465 94] /P 3 0 R /F 4 /AA << /C << /JS (var quantity = parseFloat\(this.getField\('Quantity'\).value\);
var unitPrice = parseFloat\(this.getField\('UnitPrice'\).value\);
var discountPercent = parseFloat\(this.getField\('DiscountPercent'\).value\);
if \(isNaN\(quantity\) || isNaN\(unitPrice\) || isNaN\(discountPercent\) || quantity < 0 || unitPrice < 0 || discountPercent < 0 || discountPercent > 100\) {
    event.value = 'Invalid input';
} else {
    var total = quantity * unitPrice * \(1 - discountPercent / 100\);
    event.value = \(Math.round\(total * 100\) / 100\).toFixed\(2\);
}) >> >> >>
