#ifndef MUPDF_SHARED_COMPAT_HPP
#define MUPDF_SHARED_COMPAT_HPP

#include <string_view>

namespace Mu {

// MuPDF version this project builds against (cmake/mupdf.version). The
// worker additionally reports its runtime MuPDF version as the
// "engineVersion" metadata key.
inline constexpr std::string_view MUPDF_VERSION = "@MUPDF_REQUIRED_VERSION@";

} // namespace Mu

namespace Mu::IPC {

// Compatibility version
inline constexpr std::string_view COMPAT = "@MU_COMPAT_VERSION@";

} // namespace Mu::IPC

#endif // MUPDF_SHARED_COMPAT_HPP
