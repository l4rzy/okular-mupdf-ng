#ifndef MU_SHARED_COMPAT_HPP
#define MU_SHARED_COMPAT_HPP

#include <string_view>

namespace Mu {

// MuPDF version pinned by Paperbox. The
// worker additionally reports its runtime MuPDF version in the ping response.
inline constexpr std::string_view MUPDF_VERSION = "@MUPDF_REQUIRED_VERSION@";

inline constexpr std::string_view VERSION = "@MU_COMPAT_VERSION@";

} // namespace Mu

#endif // MU_SHARED_COMPAT_HPP
